{
  "manifest_version": 3,
  "name": "RustDM Browser Bridge",
  "version": "0.1.0",
  "description": "Review a direct file link and add it to your local RustDM queue.",
  "permissions": ["contextMenus", "nativeMessaging", "storage"],
  "action": { "default_title": "Queue a file in RustDM", "default_popup": "confirm.html" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'" }
}
